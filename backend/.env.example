# Copy this file to .env for local development.
# On Render, add these under your service's "Environment" tab instead.

# MongoDB Atlas connection string (see README "MongoDB Atlas setup" section)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DB_NAME=ecomcompare

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# "mock" (default, no scraping, always reliable) or "live" (real Playwright scraping)
SCRAPER_MODE=mock

# Affiliate program IDs — leave blank until approved
AMAZON_AFFILIATE_TAG=
FLIPKART_AFFILIATE_ID=

# Seconds to cache a search result before re-fetching
CACHE_TTL_SECONDS=1800
